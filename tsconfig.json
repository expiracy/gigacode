{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["index.ts", "tui.ts", "src/**/*.ts", "tests/**/*.ts", "spike/**/*.ts", "scripts/**/*.ts"]
}
